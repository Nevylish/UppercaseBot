{
    "compilerOptions": {
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "target": "ES2020",
        "strict": false,
        "strictNullChecks": false,
        "useUnknownInCatchVariables": false,
        "resolveJsonModule": true,
        "allowJs": true,
        "skipLibCheck": true,
        "types": ["node"],
        "outDir": "dist/",
        "rootDir": "src/"
    },
    "include": ["src/**/*.ts"],
    "exclude": ["node_modules"]
}
